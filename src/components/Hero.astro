<section class="hero" id="top">
  <div class="container">
    <img
      src="/assets/logo/logo2.svg"
      alt="Mascota de Gnomecko"
      class="hero-mascot"
      data-i18n-alt="hero.mascot.alt"
    />
    <span class="hero-eyebrow" data-i18n="hero.eyebrow">Estudio pequeño, entrega directa · Lima, Perú</span>
    <h1 data-i18n="hero.title">Software para tu negocio, hecho por quien realmente lo <em>programa</em></h1>
    <p class="hero-subtitle" data-i18n="hero.subtitle">
      Landing pages, catálogos y apps a medida. Hablas directo con la
      persona que escribe el código, desde el primer boceto hasta la
      entrega.
    </p>
    <div class="hero-actions">
      <a href="#servicios" class="btn btn-primary" data-i18n="hero.cta.services">Ver servicios</a>
      <a href="#contacto" class="btn btn-secondary" data-i18n="hero.cta.contact">Escríbenos</a>
    </div>
  </div>
</section>
