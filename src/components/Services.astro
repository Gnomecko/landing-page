---
const services = [
  {
    icon: "🖥️",
    key: "1",
    title: "Landing pages y sitios web",
    description:
      "Páginas rápidas y responsivas. La identidad visual es tuya, no una plantilla con tu logo pegado encima.",
  },
  {
    icon: "📱",
    key: "2",
    title: "Apps personalizadas",
    description:
      "Aplicaciones web y móviles armadas alrededor de cómo funciona tu negocio de verdad.",
  },
  {
    icon: "🎓",
    key: "3",
    title: "Apps educativas",
    description:
      "Seguimiento de progreso, contenido interactivo, herramientas que los alumnos usan de verdad.",
  },
  {
    icon: "🎮",
    key: "4",
    title: "Videojuegos educativos",
    description:
      "Mecánicas simples, un objetivo claro y contenido pedagógico real detrás.",
  },
];
---

<section id="servicios">
  <div class="container">
    <span class="section-label" data-i18n="services.label">Qué hacemos</span>
    <h2 class="section-heading" data-i18n="services.heading">Servicios</h2>
    <p class="section-intro" data-i18n="services.intro">
      Trabajamos con empresas, emprendedores e instituciones educativas
      que necesitan algo bien hecho de principio a fin.
    </p>

    <div class="services-grid">
      {
        services.map((service) => (
          <div class="service-card">
            <div class="service-icon">{service.icon}</div>
            <h3 data-i18n={`services.${service.key}.title`}>{service.title}</h3>
            <p data-i18n={`services.${service.key}.desc`}>{service.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
