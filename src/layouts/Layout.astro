---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "GNOMECKO — Software con propósito",
  description = "GNOMECKO crea landing pages, apps a medida, apps educativas y videojuegos educativos.",
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Aplica el tema oscuro guardado ANTES de pintar, para que no haya
         parpadeo (flash claro→oscuro) al cargar. El resto de la lógica de
         tema/idioma vive en PreferencesToggle.astro. -->
    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem("gnomecko-theme");
          if (theme === "dark" || theme === "light") {
            document.documentElement.setAttribute("data-theme", theme);
          }
        } catch (e) {}
      })();
    </script>

    <!-- Favicon: mascota (isotipo) sobre fondo blanco fijo, ver public/assets/favicon/favicon.svg -->
    <link rel="icon" type="image/svg+xml" href="/assets/favicon/favicon.svg" />

    <!-- Fuentes: Space Grotesk (titulares) + Inter (texto). Si quieres
         cambiar de fuente, hazlo aquí Y en src/styles/brand.css. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <slot />
  </body>
</html>
